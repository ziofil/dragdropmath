{
  "name": "learn-math",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/licenses.mjs && tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:quick": "vitest run --exclude 'src/render/exercises.*.test.tsx' --exclude 'src/render/drag.test.tsx' --exclude 'src/render/lerp.test.tsx' --exclude 'node_modules/**'",
    "test:all": "SLOW=1 vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dragology": "0.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright-core": "1.65.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wrangler": "^4.160.0"
  }
}
